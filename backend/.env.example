# ─────────────────────────────────────────────
# AI Doctor-Patient System — Backend Environment
# ─────────────────────────────────────────────

# Server
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctor_patient_db

# Redis (Upstash Redis URL - e.g. rediss://default:<password>@<endpoint>.upstash.io:6379)
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379

# JWT
JWT_ACCESS_SECRET=change_me_to_a_minimum_64_char_random_string_in_production
JWT_REFRESH_SECRET=change_me_to_a_different_minimum_64_char_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Storage (MinIO / S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=doctor-patient-files
STORAGE_REGION=us-east-1

# AI Services
MISTRAL_API_KEY=your_mistral_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=medical_documents

# Python Microservice
PYTHON_SERVICE_URL=http://localhost:8000
PYTHON_SERVICE_TOKEN=change_me_internal_service_token

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=onboarding@resend.dev  # Use onboarding@resend.dev for Resend testing or your verified domain

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
